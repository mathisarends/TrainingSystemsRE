DATABASE_URL=postgresql+asyncpg://training:training@localhost:5432/training_system

AUTHENTICATION_FRONTEND_BASE_URL=http://localhost:5173
AUTHENTICATION_JWT_SECRET=replace-with-a-long-random-secret
AUTHENTICATION_JWT_ALGORITHM=HS256
AUTHENTICATION_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTHENTICATION_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

OAUTH_STATE_TTL_SECONDS=600

PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com

APP_ENVIRONMENT=production
APP_CORS_ORIGINS=["http://localhost:5173"]
